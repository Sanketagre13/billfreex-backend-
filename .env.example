NODE_ENV=development

CRIF_BASE_URL=https://api.staging.indiconnect.in
CRIF_SERVICE_KEY=sk_test_xxxxxxxxxxxxxxxx
CRIF_AUTHORIZATION=x-api-access indc_test_xxxxxxxxxxxxxxxx:ac_test_xxxxxxxxxxxxxxxx
CRIF_TIMEOUT_MS=45000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_SCORE_MAX=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_CREDIT_REPORT_MAX=10

# Comma-separated allowed origins, e.g.: https://billfreex.com,https://www.billfreex.com
CORS_ORIGINS=

TRUST_PROXY=1

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=billfreex_app
DB_CONNECTION_LIMIT=10

# --- Session cookie ---
SESSION_COOKIE_NAME=bfx_session
SESSION_TTL_DAYS=7
# Defaults to true in production / false in development if unset.
COOKIE_SECURE=
# Defaults to None in production / Lax in development if unset.
COOKIE_SAMESITE=

# --- Data encryption (PAN + credit report bodies at rest) ---
# base64-encoded 32-byte key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=

# Must exceed CRIF_TIMEOUT_MS with headroom — see src/creditReports/service.js
CREDIT_REPORT_LOCK_TIMEOUT_MS=60000
