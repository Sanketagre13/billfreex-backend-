# Copy to .env and fill in. Never commit .env — these are live bureau credentials.

PORT=8080
NODE_ENV=development

# CRIF / IndiConnect
CRIF_BASE_URL=https://api.staging.indiconnect.in
CRIF_SERVICE_KEY=sk_test_xxxxxxxxxxxxxxxx
CRIF_AUTHORIZATION=x-api-access indc_test_xxxxxxxxxxxxxxxx:ac_test_xxxxxxxxxxxxxxxx
CRIF_TIMEOUT_MS=45000

# Rate limiting (per IP + mobile number)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_SCORE_MAX=10

# CORS configuration for split deployment (frontend and backend on different domains)
# Set this to your frontend URL(s) when deploying separately
# Example for Vercel/Netlify: CORS_ORIGINS=https://billfreex.vercel.app
# Example for multiple domains: CORS_ORIGINS=https://billfreex.com,https://www.billfreex.com
CORS_ORIGINS=

# Set to the number of proxy hops when running behind nginx / a load balancer.
# TRUST_PROXY=1
